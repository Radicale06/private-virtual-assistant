# ============================================================================
# PVA  shared environment for docker-compose. Copy to .env and fill in.
# ============================================================================

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=pva
POSTGRES_PASSWORD=pva
POSTGRES_DB=pva
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Prisma reads DATABASE_URL directly (schema.prisma + runtime client).
DATABASE_URL=postgresql://pva:pva@postgres:5432/pva

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Token vault (encryption at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- LLM provider (active: openai) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Model tiers  verify current model ids on the provider's docs.
LLM_ROUTER_MODEL=gpt-4o-mini
LLM_MAIN_MODEL=gpt-4o
LLM_REASONING_MODEL=o4-mini
WHISPER_MODEL=whisper-1

# --- WhatsApp via Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=          # E.164 Twilio WhatsApp sender, e.g. +15559005286
TWILIO_VALIDATE_SIGNATURE=false  # set true in prod once the public webhook URL is stable
TWILIO_CONTENT_REMINDER=         # approved Content SID (HX...) for proactive reminders (optional)
TWILIO_CONTENT_BRIEFING=         # approved Content SID (HX...) for morning briefings (optional)
WHATSAPP_SHARED_NUMBER=          # public number for wa.me QR links; defaults to TWILIO_WHATSAPP_NUMBER

# --- Google OAuth (Calendar + Gmail) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# --- Calendly OAuth ---
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:8000/api/integrations/calendly/callback

# --- Zoom OAuth ---
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/api/integrations/zoom/callback

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# --- Microsoft 365 OAuth (Outlook Calendar + Mail + Teams) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_REDIRECT_URI=http://localhost:8000/api/integrations/microsoft/callback
