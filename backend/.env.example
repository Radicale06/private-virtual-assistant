# Backend-local env (mirrors root .env.example). When running via docker-compose,
# the root .env is injected. Use this when running the backend standalone.

APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

POSTGRES_USER=pva
POSTGRES_PASSWORD=pva
POSTGRES_DB=pva
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Prisma reads DATABASE_URL directly (schema.prisma + runtime client).
DATABASE_URL=postgresql://pva:pva@localhost:5432/pva

REDIS_URL=redis://localhost:6379/0

ENCRYPTION_KEY=

LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_ROUTER_MODEL=gpt-4o-mini
LLM_MAIN_MODEL=gpt-4o
LLM_REASONING_MODEL=o4-mini
WHISPER_MODEL=whisper-1

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VALIDATE_SIGNATURE=false
TWILIO_CONTENT_REMINDER=
TWILIO_CONTENT_BRIEFING=
WHATSAPP_SHARED_NUMBER=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:8000/api/integrations/calendly/callback

ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/api/integrations/zoom/callback

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# --- Microsoft 365 OAuth (Outlook Calendar + Mail + Teams) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_REDIRECT_URI=http://localhost:8000/api/integrations/microsoft/callback
